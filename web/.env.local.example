# Copy to .env.local and fill in values before running `npm run dev`

# Backend API base URL (no trailing slash)
# Dev:  http://localhost:8000
# Prod: https://laksh-api.fly.dev
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Optional: public R2 base URL for direct asset links (no signed URL needed)
# Leave empty to use signed URLs exclusively.
NEXT_PUBLIC_R2_PUBLIC_BASE=
